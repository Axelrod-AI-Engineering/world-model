+def test_world_model_writes_only_propose_and_never_approve(client, endpoints, world_model_service) -> None:
+    token = _complete_oauth_flow(client, endpoints)
+    forecast = _wm(client, token, "world_model_forecast", {"question": "What if the BoJ hiked by 25bp?"})
+    assert forecast["structuredContent"]["path"] == "/forecasts"
+    assert json.loads(forecast["structuredContent"]["body"]) == {"question": "What if the BoJ hiked by 25bp?",
+                                                                 "horizon_days": 182}
+    for bad in ({}, {"question": "q", "thesis_id": "S-T3"}):
+        refused = _wm(client, token, "world_model_forecast", bad)
+        assert refused.get("isError") is True and "invalid_request" in _tool_error_text(refused)
+    imported = _wm(client, token, "world_model_import_bundle", {"bundle_id": "B1", "item_ids": ["i1"]})
+    assert json.loads(imported["structuredContent"]["body"]) == {"review": "queue", "item_ids": ["i1"]}
+    tools = {tool["name"]: tool for tool in _mcp_result(_tools_list(client, token))["tools"]}
+    assert not any("decide" in n or "approve" in n for n in tools)
+    assert "world_model_import_bundle" in tools and "review" not in tools["world_model_import_bundle"]["inputSchema"]["properties"]
+    for name in ("world_model_forecast", "world_model_ingest_source", "world_model_import_bundle"):
+        hints = tools[name]["annotations"]
+        assert hints["readOnlyHint"] is False and hints["destructiveHint"] is False and hints["openWorldHint"] is False
+    for name in ("world_model_state", "world_model_query", "world_model_trace", "world_model_construction"):
+        assert tools[name]["annotations"]["readOnlyHint"] is True, name
