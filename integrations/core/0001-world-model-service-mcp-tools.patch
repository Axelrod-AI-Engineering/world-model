+
+    seen: list[httpx.Request] = []
+
+    def answer(request: httpx.Request) -> httpx.Response:
+        seen.append(request)
+        path = request.url.path.removeprefix("/api/world-model")
+        if path == "/entities/nobody":
+            return httpx.Response(404, json={"error": {"code": "node_not_found", "message": "no entity 'nobody'"}})
+        if path == "/values/broken":
+            return httpx.Response(502, text="<html>bad gateway</html>")
+        if path == "/values/down":
+            raise httpx.ConnectError("refused", request=request)
+        if path.startswith("/construction/") and request.url.params.get("format") == "markdown":
+            return httpx.Response(200, text="# Toyota: business construction\n")
+        if path == "/proposals":
+            return httpx.Response(200, json=[{"id": "p1"}])
+        body = {"state": WM_STATE, "path": path, "params": dict(request.url.params)}
+        if request.method == "POST":
+            body["body"] = request.content.decode(errors="replace")[:4000]
+        return httpx.Response(201 if request.method == "POST" else 200, json=body)
+
+    monkeypatch.setattr(mcp_world_model, "transport", httpx.MockTransport(answer))
+    monkeypatch.setattr(main.settings, "world_model_service_url", "https://world-model.test/")
+    monkeypatch.setattr(main.settings, "world_model_service_keys_raw", f"{TEST_ORG_ID}={WM_KEY}")
+    return seen
