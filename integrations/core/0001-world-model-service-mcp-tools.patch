+def test_world_model_errors_come_back_as_tool_errors(client, endpoints, world_model_service, monkeypatch) -> None:
+    token = _complete_oauth_flow(client, endpoints)
+    for args, name, code in (({"entity_id": "nobody"}, "world_model_get_entity", "node_not_found: no entity 'nobody'"),
