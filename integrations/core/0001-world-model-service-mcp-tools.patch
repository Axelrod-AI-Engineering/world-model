+        result = _wm(client, token, name, args)
+        assert result.get("isError") is True and code in _tool_error_text(result), name
+    outsider = _complete_oauth_flow(client, endpoints, username="outsider", org_id=OTHER_ORG_ID)
+    result = _wm(client, outsider, "world_model_state")
+    assert result.get("isError") is True and "world_model_unavailable" in _tool_error_text(result)
+    monkeypatch.setattr(main.settings, "world_model_service_keys_raw", "*=" + WM_KEY)
+    assert _wm(client, outsider, "world_model_state").get("isError") is not True
+    monkeypatch.setattr(main.settings, "world_model_service_url", "")
+    unset = _wm(client, token, "world_model_state")
+    assert unset.get("isError") is True and "world_model_unavailable" in _tool_error_text(unset)
