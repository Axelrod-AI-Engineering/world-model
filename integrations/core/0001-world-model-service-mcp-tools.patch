-"""MCP adapter for World Model reads."""
+"""MCP adapter for World Model reads.
+
+`search_canonical` searches the canonical identities core stores. The `world_model_*` tools reach the Axelrod world
+model service (the causal model: entities, values, causal links with effects and timing, forecasts, and business
+construction), over its REST API at `Settings.world_model_service_url`. Each call carries the key for the caller's
+organization and names the org user it is made for (`X-Axelrod-On-Behalf-Of`), so the service records the person
+on every import. The service's own MCP server publishes the same tools; core re-publishes them so a host connected
+to core sees one catalog under one sign-in.
+
+Writes stay behind review: ingesting a project source and importing a bundle only propose graph updates, which wait
+for a person to approve them in the world model's review. No tool here approves or rejects a proposal.
+"""
 
 from __future__ import annotations
 
 from collections.abc import Callable
+from datetime import datetime
+from typing import Annotated, Any, Literal
 
+import httpx
+from fastapi import HTTPException
 from mcp.server.mcpserver.exceptions import ToolError
-from pydantic import ValidationError
+from pydantic import BaseModel, ConfigDict, Field, ValidationError
 
 from axelrod_app.contracts.v1.world_model import CanonicalSearchResult
 from axelrod_app.persistence_protocols import IdentityStore
 from axelrod_app.routers.deps import EdgeDeps
 from axelrod_app.simulation_service import SimulationError, service_for_principal
 
+WORLD_MODEL_API = "/api/world-model"
+WORLD_MODEL_TIMEOUT_SECONDS = 120.0
+
+# A project source's type, as the world model's ingestion names it (its `source_type`).
+SOURCE_TYPES: dict[str, str] = {"portfolio": "client_model", "excel_model": "client_model", "filing": "filing",
+                                "document": "other", "other": "other"}
+WorldModelSourceType = Literal["broker_research", "expert_call", "news", "central_bank", "data", "filing",
+                               "client_model", "other"]
+
+Version = Annotated[int | None, Field(ge=1, description="Pin the read to this committed state version.")]
+AsOf = Annotated[datetime | None, Field(description="Pin the read to the state at the last day closed at or before this time.")]
+
+# Replaced in tests with an httpx.MockTransport; None uses the network.
+transport: httpx.AsyncBaseTransport | None = None
+
+
+class WorldModelState(BaseModel):
+    """The state a world-model answer was served from. Pin a later read to it with `version`."""
+
+    model_config = ConfigDict(extra="allow")
+
+    scenario: str
+    version: int
+    state_hash: str | None = None
+    as_of: str | None = None
+    latest_version: int | None = None
+    clock: str | None = None
+
+
+class WorldModelResult(BaseModel):
+    """A world-model service answer, as the service returns it. Every read names its `state`."""
+
+    model_config = ConfigDict(extra="allow")
+
+    state: WorldModelState | None = None
+
+
+class WorldModelMarkdown(BaseModel):
+    """A readable view, as markdown."""
+
+    markdown: str
+
+
+def parse_service_keys(raw: str) -> dict[str, str]:
+    """`org_id=key` entries, comma-separated; `*=key` serves every other organization."""
+    keys: dict[str, str] = {}
+    for entry in (e.strip() for e in raw.split(",")):
+        if not entry:
+            continue
+        org, sep, key = entry.partition("=")
+        if not sep or not org.strip() or len(key.strip()) < 24:
+            raise ValueError("AXELROD_WORLD_MODEL_SERVICE_KEYS entries are org_id=key, with keys of 24+ characters")
+        keys[org.strip()] = key.strip()
+    return keys
+
 
 def register_mcp_world_model_tools(
     *,
@@ -19,7 +89,8 @@ def register_mcp_world_model_tools(
     session_store: IdentityStore,
     get_edge_deps: Callable[[], EdgeDeps],
 ) -> None:
-    from axelrod_app.mcp_server import mcp_principal, org_user_from_mcp_token
+    from axelrod_app.mcp_server import mcp_principal, org_user_from_mcp_token, tool_error_from_http
+    from axelrod_app.routers.sources import open_source_download_for_creator
 
     def search(analysis_id: str, query: str) -> CanonicalSearchResult:
         try:
@@ -34,3 +105,160 @@ def register_mcp_world_model_tools(
     @register_tool(description="Search World Model canonical identities in an analysis the caller can view. Does not pin or write. Further World Model reads can extend this tool.")
     def search_canonical(analysis_id: str, query: str = "") -> CanonicalSearchResult:
         return search(analysis_id, query)
+
+    # -- the world model service ----------------------------------------------------------------------------------
+    def connection() -> tuple[str, dict[str, str]]:
+        user = org_user_from_mcp_token(session_store)
+        settings = get_edge_deps().settings
+        base = settings.world_model_service_url.rstrip("/")
+        keys = parse_service_keys(settings.world_model_service_keys_raw)
+        key = keys.get(user.org_id) or keys.get("*")
+        if not base or not key:
+            raise ToolError("world_model_unavailable: the world model service is not configured for this organization")
+        return base, {"Authorization": f"Bearer {key}", "X-Axelrod-On-Behalf-Of": f"{user.org_id}/{user.org_user_id}"}
+
+    async def request(method: str, path: str, **kw: Any) -> httpx.Response:
+        base, headers = connection()
+        try:
+            async with httpx.AsyncClient(base_url=base, transport=transport,
+                                         timeout=WORLD_MODEL_TIMEOUT_SECONDS) as client:
+                r = await client.request(method, WORLD_MODEL_API + path, headers=headers, **kw)
+        except httpx.HTTPError as exc:
+            raise ToolError(f"world_model_unavailable: {type(exc).__name__}") from exc
+        if r.status_code >= 400:
+            try:
+                err = r.json()["error"]
+                code, message = err["code"], err["message"]
+            except (ValueError, KeyError, TypeError):
+                code, message = "world_model_error", f"HTTP {r.status_code}"
+            raise ToolError(f"{code}: {message}")
+        return r
+
+    async def call(method: str, path: str, **kw: Any) -> WorldModelResult:
+        body = (await request(method, path, **kw)).json()
+        return WorldModelResult.model_validate(body if isinstance(body, dict) else {"items": body})
+
+    def params(**kw: Any) -> dict[str, Any]:
+        return {k: v.isoformat() if isinstance(v, datetime) else v for k, v in kw.items() if v not in (None, "")}
+
+    @register_tool(description="The world model state that reads are served from: version, state hash, the model's clock, and counts of entities, values, links and stored documents.")
+    async def world_model_state() -> WorldModelResult:
+        return await call("GET", "/state")
+
+    @register_tool(description="Entities, values (levels with spreads, in their units) and causal edges (effect, existence probability, timing, evidence) for the named node ids or names in q, and their neighbours up to `depth` links. Pin with version or as_of to reproduce a cited answer.")
+    async def world_model_query(
+        node_ids: list[str] | None = None,
+        q: str = "",
+        depth: Annotated[int, Field(ge=0, le=4)] = 1,
+        version: Version = None,
+        as_of: AsOf = None,
+        limit: Annotated[int, Field(ge=1, le=1000)] = 200,
+    ) -> WorldModelResult:
+        return await call("GET", "/query", params=params(node_ids=",".join(node_ids or []), q=q, depth=depth,
+                                                          version=version, as_of=as_of, limit=limit))
+
+    @register_tool(description="World model entities and values whose names contain q, prefix matches first.")
+    async def world_model_search_nodes(q: str = "", limit: Annotated[int, Field(ge=1, le=500)] = 50) -> WorldModelResult:
+        return await call("GET", "/nodes", params=params(q=q, limit=limit))
+
+    @register_tool(description="One world model entity: its values, concepts, and the causal links in and out.")
+    async def world_model_get_entity(entity_id: str) -> WorldModelResult:
+        return await call("GET", f"/entities/{entity_id}")
+
+    @register_tool(description="One world model value: its level and spread in its unit, whether it was observed, its drivers and its effects.")
+    async def world_model_get_value(value_id: str) -> WorldModelResult:
+        return await call("GET", f"/values/{value_id}")
+
+    @register_tool(description="The world model's static taxonomy: concepts, their parents, and the entities under each.")
+    async def world_model_taxonomy() -> WorldModelResult:
+        return await call("GET", "/taxonomy")
+
+    @register_tool(description="Search documents ingested into the world model, and its names: keyword, prefix, semantic, graph, or hybrid. Each hit cites its document and chunk.")
+    async def world_model_search(
+        q: str,
+        mode: Literal["keyword", "prefix", "semantic", "graph", "hybrid"] = "hybrid",
+        limit: Annotated[int, Field(ge=1, le=100)] = 20,
+    ) -> WorldModelResult:
+        return await call("GET", "/search", params=params(q=q, mode=mode, limit=limit))
+
+    @register_tool(description="How a company is built in the world model: its business composition (segments, regions and other views, with residuals and eliminations), its named operating and financial paths with each transition (mechanism, condition, observable, timing, evidence, breaker, calibration), and any structural problems.")
+    async def world_model_construction(entity_id: str, version: Version = None) -> WorldModelResult:
+        return await call("GET", f"/construction/{entity_id}", params=params(version=version))
+
+    @register_tool(description="A company's business construction as a readable markdown page: composition tables, and each path as a chain with its transition table. Steps whose size is unknown are marked.")
+    async def world_model_construction_markdown(entity_id: str) -> WorldModelMarkdown:
+        r = await request("GET", f"/construction/{entity_id}", params={"format": "markdown"})
+        return WorldModelMarkdown(markdown=r.text)
+
+    @register_tool(description="Follow a change in one world model value through every link, calibrated or not, to a company's financial endpoints: each route, where it stops, and which steps are uncalibrated (sign known, size unknown) or lack a transition.")
+    async def world_model_trace(entity_id: str, start: str) -> WorldModelResult:
+        return await call("GET", f"/construction/{entity_id}/trace", params={"start": start})
+
+    @register_tool(description="Pose a what-if to the world model (a question, or a ready thesis id) and forecast it: targets with ranges, transmission by order, and the scenario table. `unquantified` lists links the shock reaches whose size is unknown: report them as represented but unsized, never as zero.")
+    async def world_model_forecast(
+        question: str = "",
+        thesis_id: str = "",
+        horizon_days: Annotated[int, Field(ge=7, le=1095)] = 182,
+    ) -> WorldModelResult:
+        if bool(question.strip()) == bool(thesis_id.strip()):
+            raise ToolError("invalid_request: give exactly one of question and thesis_id")
+        return await call("POST", "/forecasts", json=params(question=question.strip(), thesis_id=thesis_id.strip(),
+                                                             horizon_days=horizon_days))
+
+    @register_tool(description="One world model forecast, with the state it was based on.")
+    async def world_model_get_forecast(forecast_id: str) -> WorldModelResult:
+        return await call("GET", f"/forecasts/{forecast_id}")
+
+    @register_tool(description="A world model forecast's brief: summary, expected timing, exposures, indicators to watch, and evidence.")
+    async def world_model_forecast_brief(forecast_id: str) -> WorldModelResult:
+        return await call("GET", f"/forecasts/{forecast_id}/brief")
+
+    @register_tool(description="The world model, and a forecast when one is named, in the client's v4.1.4 world-model format (domain pack, registry entry, evidence packs, load order), for agents that read that format.")
+    async def world_model_context_v4(forecast_id: str = "") -> WorldModelResult:
+        return await call("GET", "/context/v4", params=params(forecast=forecast_id))
+
+    @register_tool(description="Documents stored in the world model's lakehouse, by event time or ingestion time.")
+    async def world_model_list_documents(
+        order: Literal["event_time", "ingested_at"] = "event_time",
+        limit: Annotated[int, Field(ge=1, le=1000)] = 100,
+        offset: Annotated[int, Field(ge=0)] = 0,
+    ) -> WorldModelResult:
+        return await call("GET", "/documents", params=params(order=order, limit=limit, offset=offset))
+
+    @register_tool(description="One world model import bundle: its dated items, the signals each claims, and the quotes they came from.")
+    async def world_model_get_bundle(bundle_id: str) -> WorldModelResult:
+        return await call("GET", f"/bundles/{bundle_id}")
+
+    @register_tool(description="Proposed world model graph updates, pending review by default.")
+    async def world_model_list_proposals(
+        status: Literal["pending", "approved", "rejected", "all"] = "pending",
+        limit: Annotated[int, Field(ge=1, le=1000)] = 100,
+    ) -> WorldModelResult:
+        return await call("GET", "/proposals", params=params(status=status, limit=limit))
+
+    @register_tool(description="Send a project source you created to the world model: it is stored, parsed and indexed, and read into an import bundle of proposed graph updates. The same file is stored once. Nothing in the model changes until the bundle is imported and a person approves each update.")
+    async def world_model_ingest_source(
+        source_id: str,
+        source_type: WorldModelSourceType | None = None,
+        published_at: datetime | None = None,
+    ) -> WorldModelResult:
+        from axelrod_app.mcp_server import mcp_principal as principal_of
+
+        deps = get_edge_deps()
+        principal = principal_of(org_user_from_mcp_token(session_store))
+        try:
+            source, handle = open_source_download_for_creator(deps, principal, source_id.strip())
+        except HTTPException as exc:
+            raise tool_error_from_http(exc) from exc
+        try:
+            data = handle.read()
+        finally:
+            handle.close()
+        form = params(source=source.display_name, source_type=source_type or SOURCE_TYPES.get(source.source_type, "other"),
+                      published_at=published_at)
+        name = source.original_filename or source.display_name
+        return await call("POST", "/documents", files=[("files", (name, data, source.mime_type))], data=form)
+
+    @register_tool(description="Propose a world model import bundle's items as graph updates, in event-time order. Each update waits for a person to approve or reject it in the world model's review; this tool never approves.")
+    async def world_model_import_bundle(bundle_id: str, item_ids: list[str] | None = None) -> WorldModelResult:
+        return await call("POST", f"/bundles/{bundle_id}/import", json=params(review="queue", item_ids=item_ids))
