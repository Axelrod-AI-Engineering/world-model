@@ -1,17 +1,92 @@
-"""MCP adapter for World Model reads."""
+"""MCP adapter for World Model reads.
+
+`search_canonical` searches the canonical identities core stores. The `world_model_*` tools reach the Axelrod world
+model service (the causal model: entities with their attributes, relationships between attributes with their evidence,
+simulations, and business construction), over its v1 API (`/v1/world-models/{id}/...`) at
+`Settings.world_model_service_url`. Each call carries the key for the caller's organization; every tool takes a
+`world_model_id`, which defaults to the organization's only world model. The service's own MCP server publishes the
+same nouns; core re-publishes them so a host connected to core sees one catalog under one sign-in.
+
+Read only (the API review, Oct 19): core's backend MCP reaches the world model to read, not to write. Documents,
+proposed changes and simulations come from the web interface and the data-ingestion pipeline. The organization's key
+holds `world_model:read` only, and the service reads only for the `core-mcp` channel whatever a credential asks.
+"""
 
 from __future__ import annotations
 
 from collections.abc import Callable
+from datetime import datetime
+from typing import Annotated, Any, Literal
 
+import httpx
 from mcp.server.mcpserver.exceptions import ToolError
-from pydantic import ValidationError
+from pydantic import BaseModel, ConfigDict, Field, ValidationError
 
 from axelrod_app.contracts.v1.world_model import CanonicalSearchResult
 from axelrod_app.persistence_protocols import IdentityStore
 from axelrod_app.routers.deps import EdgeDeps
 from axelrod_app.simulation_service import SimulationError, service_for_principal
 
+WORLD_MODEL_API = "/v1"
+WORLD_MODEL_TIMEOUT_SECONDS = 120.0
+
+Version = Annotated[int | None, Field(ge=1, description="Pin the read to this committed state version.")]
+WorldModelId = Annotated[str, Field(description="The world model (default: the organization's only one).")]
+AsOf = Annotated[datetime | None, Field(description="Pin the read to the state at the last day closed at or before this time.")]
+
+# Replaced in tests with an httpx.MockTransport; None uses the network.
+transport: httpx.AsyncBaseTransport | None = None
+
+
+class WorldModelVersion(BaseModel):
+    """The version a world-model answer was read from. Pin a later read to it with `version`."""
+
+    model_config = ConfigDict(extra="allow")
+
+    number: int
+    state_hash: str | None = None
+    committed_at: str | None = None
+    latest: int | None = None
+    clock: str | None = None
+
+
+class WorldModelMeta(BaseModel):
+    """About an answer: its request id, the version it was read from, and a list's next cursor."""
+
+    model_config = ConfigDict(extra="allow")
+
+    request_id: str | None = None
+    version: WorldModelVersion | None = None
+    next_cursor: str | None = None
+
+
+class WorldModelResult(BaseModel):
+    """A world-model service answer, as the service returns it: `data`, and `meta` naming the version read."""
+
+    model_config = ConfigDict(extra="allow")
+
+    data: Any = None
+    meta: WorldModelMeta | None = None
+
+
+class WorldModelMarkdown(BaseModel):
+    """A readable view, as markdown."""
+
+    markdown: str
+
+
+def parse_service_keys(raw: str) -> dict[str, str]:
+    """`org_id=key` entries, comma-separated; `*=key` serves every other organization."""
+    keys: dict[str, str] = {}
+    for entry in (e.strip() for e in raw.split(",")):
+        if not entry:
+            continue
+        org, sep, key = entry.partition("=")
+        if not sep or not org.strip() or len(key.strip()) < 24:
+            raise ValueError("AXELROD_WORLD_MODEL_SERVICE_KEYS entries are org_id=key, with keys of 24+ characters")
+        keys[org.strip()] = key.strip()
+    return keys
+
 
 def register_mcp_world_model_tools(
     *,
@@ -34,3 +109,164 @@ def register_mcp_world_model_tools(
     @register_tool(description="Search World Model canonical identities in an analysis the caller can view. Does not pin or write. Further World Model reads can extend this tool.")
     def search_canonical(analysis_id: str, query: str = "") -> CanonicalSearchResult:
         return search(analysis_id, query)
+
+    # -- the world model service ----------------------------------------------------------------------------------
+    def connection() -> tuple[str, dict[str, str]]:
+        user = org_user_from_mcp_token(session_store)
+        settings = get_edge_deps().settings
+        base = settings.world_model_service_url.rstrip("/")
+        keys = parse_service_keys(settings.world_model_service_keys_raw)
+        key = keys.get(user.org_id) or keys.get("*")
+        if not base or not key:
+            raise ToolError("world_model_unavailable: the world model service is not configured for this organization")
+        return base, {"Authorization": f"Bearer {key}"}
+
+    async def request(method: str, path: str, **kw: Any) -> httpx.Response:
+        base, headers = connection()
+        try:
+            async with httpx.AsyncClient(base_url=base, transport=transport,
+                                         timeout=WORLD_MODEL_TIMEOUT_SECONDS) as client:
+                r = await client.request(method, WORLD_MODEL_API + path, headers=headers, **kw)
+        except httpx.HTTPError as exc:
+            raise ToolError(f"world_model_unavailable: {type(exc).__name__}") from exc
+        if r.status_code >= 400:
+            try:
+                err = r.json()
+                code, message = err["code"], err["detail"]
+            except (ValueError, KeyError, TypeError):
+                code, message = "world_model_error", f"HTTP {r.status_code}"
+            raise ToolError(f"{code}: {message}")
+        return r
+
+    async def call(method: str, path: str, **kw: Any) -> WorldModelResult:
+        body = (await request(method, path, **kw)).json()
+        return WorldModelResult.model_validate(body if isinstance(body, dict) else {"items": body})
+
+    def params(**kw: Any) -> dict[str, Any]:
+        return {k: v.isoformat() if isinstance(v, datetime) else v for k, v in kw.items() if v not in (None, "")}
+
+    async def model_path(world_model_id: str) -> str:
+        """`/world-models/{id}`: the one named, or the organization's only world model."""
+        if world_model_id.strip():
+            return f"/world-models/{world_model_id.strip()}"
+        ids = [m["id"] for m in (await call("GET", "/world-models")).data or []]
+        if len(ids) != 1:
+            raise ToolError(f"invalid_request: name a world_model_id (this organization has {len(ids)})")
+        return f"/world-models/{ids[0]}"
+
+    @register_tool(description="The organization's world models: each one's latest version, clock, and counts.")
+    async def world_model_list_world_models() -> WorldModelResult:
+        return await call("GET", "/world-models")
+
+    @register_tool(description="One world model: its latest version, the model's clock, and counts of entities, attributes, relationships, groups, documents and bundles. Pin later reads with that version to reproduce a cited answer.")
+    async def world_model_get_world_model(world_model_id: WorldModelId = "") -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id))
+
+    @register_tool(description="A subgraph for context: entities with the attributes reached nested (levels with spreads, in their units; an attribute's id is `<entity id>.<key>`, e.g. toyota.operating_profit) and the relationships between them (effect, confidence, timing), for the named entities or attributes or names in q, and their neighbours up to `depth` relationships. Pin with version or as_of to reproduce a cited answer.")
+    async def world_model_graph(
+        world_model_id: WorldModelId = "",
+        entities: list[str] | None = None,
+        attributes: list[str] | None = None,
+        q: str = "",
+        depth: Annotated[int, Field(ge=0, le=4)] = 1,
+        version: Version = None,
+        as_of: AsOf = None,
+        limit: Annotated[int, Field(ge=1, le=2000)] = 200,
+    ) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + "/graph", params=params(
+            entities=",".join(entities or []), attributes=",".join(attributes or []), q=q, depth=depth,
+            version=version, as_of=as_of, limit=limit))
+
+    @register_tool(description="World model entities by name (q also matches their attributes' names), type or concept, prefix matches first; an entity matched through its attributes nests just those.")
+    async def world_model_list_entities(
+        world_model_id: WorldModelId = "",
+        q: str = "",
+        type: str = "",
+        concept: str = "",
+        limit: Annotated[int, Field(ge=1, le=200)] = 50,
+        cursor: str = "",
+        version: Version = None,
+    ) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + "/entities", params=params(
+            q=q, type=type, concept=concept, limit=limit, cursor=cursor, version=version))
+
+    @register_tool(description="One world model entity: all its attributes, its concepts and groups.")
+    async def world_model_get_entity(entity_id: str, world_model_id: WorldModelId = "", version: Version = None) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + f"/entities/{entity_id}", params=params(version=version))
+
+    @register_tool(description="One attribute of a world model entity: its level and spread in its unit, whether it is observed, and its latest observation. `attribute` is its key in the entity (operating_profit) or its full id (toyota.operating_profit).")
+    async def world_model_get_attribute(entity_id: str, attribute: str, world_model_id: WorldModelId = "", version: Version = None) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + f"/entities/{entity_id}/attributes/{attribute}",
+                          params=params(version=version))
+
+    @register_tool(description="The world model's taxonomy: concepts, their parents, and the entities under each.")
+    async def world_model_list_concepts(world_model_id: WorldModelId = "", limit: Annotated[int, Field(ge=1, le=200)] = 200, cursor: str = "") -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + "/concepts", params=params(limit=limit, cursor=cursor))
+
+    @register_tool(description="Search documents ingested into the world model, and its names: keyword, prefix, semantic, graph, or hybrid. Each hit cites its document and passage, or names an entity or attribute.")
+    async def world_model_search(
+        q: str,
+        world_model_id: WorldModelId = "",
+        mode: Literal["keyword", "prefix", "semantic", "graph", "hybrid"] = "hybrid",
+        limit: Annotated[int, Field(ge=1, le=100)] = 20,
+    ) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + "/search", params=params(q=q, mode=mode, limit=limit))
+
+    @register_tool(description="How a company is built in the world model: its attributes, its business compositions (driving or reconciling views of a total), identities, stock-flows, its named operating and financial paths with each transition (mechanism, condition, observable, timing, evidence, breaker, calibration), link counts, and any structural problems.")
+    async def world_model_construction(entity_id: str, world_model_id: WorldModelId = "", version: Version = None) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + f"/entities/{entity_id}/construction",
+                          params=params(version=version))
+
+    @register_tool(description="A company's business construction as a readable markdown page: composition tables, and each path as a chain with its transition table. Steps whose size is unknown are marked.")
+    async def world_model_construction_markdown(entity_id: str, world_model_id: WorldModelId = "") -> WorldModelMarkdown:
+        r = await request("GET", await model_path(world_model_id) + f"/entities/{entity_id}/construction",
+                          params={"format": "markdown"})
+        return WorldModelMarkdown(markdown=r.text)
+
+    @register_tool(description="Follow a change in one world model attribute (`start`: a full attribute id, or a key of the company's own attributes) through every relationship, calibrated or not, to a company's financial endpoints: each route, where it stops, and which steps are uncalibrated (sign known, size unknown) or lack a transition.")
+    async def world_model_trace(
+        entity_id: str,
+        start: str,
+        world_model_id: WorldModelId = "",
+        through_totals: Annotated[bool, Field(description="Go on through the totals a route reaches.")] = False,
+        max_depth: Annotated[int, Field(ge=1, le=16, description="The longest route followed, in relationships.")] = 8,
+    ) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + f"/entities/{entity_id}/traces",
+                          params={"from": start, "through_totals": through_totals, "max_depth": max_depth})
+
+    @register_tool(description="One world model simulation, with the version it ran on: targets with ranges, the scenario table, and the uncalibrated relationships it reached.")
+    async def world_model_get_simulation(simulation_id: str, world_model_id: WorldModelId = "") -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + f"/simulations/{simulation_id}")
+
+    @register_tool(description="A world model simulation's brief: summary, expected timing, exposures, indicators to watch, evidence, and calculation coverage.")
+    async def world_model_simulation_brief(simulation_id: str, world_model_id: WorldModelId = "") -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + f"/simulations/{simulation_id}/brief")
+
+    @register_tool(description="The world model, and a simulation when one is named, in the client's v4.1.4 world-model format (domain pack, registry entry, evidence packs, load order), for agents that read that format.")
+    async def world_model_export_v4(world_model_id: WorldModelId = "", simulation_id: str = "") -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + "/exports/v4.1.4", params=params(simulation=simulation_id))
+
+    @register_tool(description="Documents stored in the world model's lakehouse, by event time or ingestion time.")
+    async def world_model_list_documents(
+        world_model_id: WorldModelId = "",
+        order: Literal["event_time", "ingested_at"] = "event_time",
+        limit: Annotated[int, Field(ge=1, le=200)] = 50,
+        cursor: str = "",
+    ) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + "/documents", params=params(order=order, limit=limit, cursor=cursor))
+
+    @register_tool(description="One world model bundle: research read into dated items, each with the signals it claims and the quotes they came from.")
+    async def world_model_get_bundle(bundle_id: str, world_model_id: WorldModelId = "") -> WorldModelResult:
+        path = await model_path(world_model_id) + f"/bundles/{bundle_id}"
+        bundle = await call("GET", path)
+        items = await call("GET", path + "/items", params={"limit": 200})
+        return WorldModelResult(data={**(bundle.data or {}), "items": items.data}, meta=bundle.meta)
+
+    @register_tool(description="Proposed world model changes, pending review by default, each with who proposed and who decided it.")
+    async def world_model_list_changes(
+        world_model_id: WorldModelId = "",
+        status: Literal["pending", "approved", "rejected", "all"] = "pending",
+        limit: Annotated[int, Field(ge=1, le=200)] = 50,
+        cursor: str = "",
+    ) -> WorldModelResult:
+        return await call("GET", await model_path(world_model_id) + "/changes", params=params(status=status, limit=limit, cursor=cursor))
