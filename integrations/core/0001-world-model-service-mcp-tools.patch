+def test_world_model_tools_only_read(client, endpoints, world_model_service) -> None:
+    """Core's backend MCP reads the world model only (the API review, Oct 19): no tool writes or decides, every tool is
+    read-only, and every request it makes is a GET."""
+    token = _complete_oauth_flow(client, endpoints)
+    tools = {tool["name"]: tool for tool in _mcp_result(_tools_list(client, token))["tools"]}
+    wm_tools = [n for n in tools if n.startswith("world_model_")]
+    assert len(wm_tools) == 17
+    for word in ("decide", "approve", "reject", "simulate", "ingest", "propose", "create", "delete"):
+        assert not any(word in n for n in wm_tools), word
+    for name in wm_tools:
+        assert tools[name]["annotations"]["readOnlyHint"] is True, name
+    for name in ("world_model_get_world_model", "world_model_graph", "world_model_trace", "world_model_construction"):
+        _wm(client, token, name, {"entity_id": "toyota", "start": "boj.policy_rate"} if name in (
+            "world_model_trace", "world_model_construction") else {})
+    assert world_model_service and all(r.method == "GET" for r in world_model_service)
